{
  "name": "student-erp-mobile",
  "version": "1.0.0",
  "description": "Faculty Student ERP — React Native Expo App for SVCE Bengaluru",
  "main": "expo-router/entry",
  "scripts": {
    "start":         "node node_modules/@expo/cli/build/bin/cli start --clear --host lan",
    "start:tunnel":  "node node_modules/@expo/cli/build/bin/cli start --clear --tunnel",
    "android":       "node node_modules/@expo/cli/build/bin/cli start --android --clear",
    "ios":           "node node_modules/@expo/cli/build/bin/cli start --ios --clear",
    "backend":       "node ../backend/server.js",
    "backend:dev":   "cd ../backend && npx nodemon server.js",
    "db:migrate":    "node ../backend/scripts/migrate.js",
    "db:seed":       "node ../backend/scripts/seed.js",
    "db:check":      "node ../backend/scripts/check_schema.js",
    "db:schema":     "psql -U postgres -d student_erp -f ../database/schema.sql"
  },
  "dependencies": {
    "@expo/vector-icons": "15.1.1",
    "@react-native-picker/picker": "2.11.1",
    "axios": "^1.19.0",
    "expo": "54.0.36",
    "expo-asset": "12.0.13",
    "expo-constants": "18.0.13",
    "expo-document-picker": "14.0.8",
    "expo-file-system": "19.0.23",
    "expo-font": "14.0.12",
    "expo-linking": "8.0.12",
    "expo-print": "15.0.8",
    "expo-router": "6.0.24",
    "expo-sharing": "14.0.8",
    "expo-status-bar": "^3.0.9",
    "react": "19.1.4",
    "react-native": "0.81.6",
    "react-native-safe-area-context": "^5.6.0",
    "react-native-screens": "4.16.0",
    "react-native-svg": "15.12.1",
    "string-similarity": "4.0.4"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "babel-preset-expo": "^54.0.12"
  },
  "private": true
}
